{
  "name": "the-reading-vault",
  "version": "1.0.0",
  "description": "A comprehensive reading management system that tracks user reading sessions, preferences, and provides personalized book recommendations based on reading history and ratings.",
  "license": "ISC",
  "author": "Fausto Oliva",
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "start:api": "npm start --workspace=api",
    "dev:api": "npm run dev --workspace=api",
    "start:mobile": "npm start --workspace=mobile",
    "start:web": "npm start --workspace=mobile --web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.1.0",
    "prettier": "^3.8.1"
  }
}
